<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for microphone capture when Hardened Runtime is enabled. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Ad-hoc and self-signed builds have no Team ID, so library validation
	     refuses the embedded Sparkle.framework and the app dies at launch. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
