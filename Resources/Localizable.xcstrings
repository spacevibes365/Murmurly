    "Drag it with the mouse — its position is remembered. Even when turned off, it shows errors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Du kannst ihn mit der Maus verschieben – die Position wird gemerkt. Auch ausgeschaltet zeigt er Fehler an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Puedes arrastrarlo — su posición se recuerda. Aunque esté desactivado, muestra los errores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites-le glisser avec la souris — sa position est mémorisée. Même désactivé, il affiche les erreurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascinalo con il mouse — la posizione viene ricordata. Anche se disattivato, mostra gli errori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "マウスでドラッグして移動できます。位置は記憶されます。オフにしていても、エラーは表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "마우스로 드래그해서 옮길 수 있으며 위치가 기억됩니다. 꺼져 있어도 오류는 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij go myszą — jego położenie zostanie zapamiętane. Nawet wyłączony pokazuje błędy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste-o com o mouse — a posição fica memorizada. Mesmo desativado, ele mostra erros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите его мышью — положение запомнится. Даже выключенный, он покажет ошибку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Перетягніть його мишею — положення запам’ятається. Навіть вимкнений, він показує помилки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "可以用鼠标拖动它，位置会被记住。即使关闭，它也会显示错误。"
          }
        }
      }
    },
    "Drop audio or video here" : {
