            "value" : "Po zatrzymaniu nagrywania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ao terminar a gravação"
          }
        },
        "ru" : {
          "stringUnit" : {
