    "After a recording stops and when the app starts, meeting tracks are compressed without loss — to 24 bits, like dictations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach dem Ende einer Aufnahme und beim Start der App werden die Spuren von Meetings verlustfrei komprimiert – auf 24 Bit, wie Diktate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al detener una grabación y al abrir la app, las pistas de las reuniones se comprimen sin pérdida — a 24 bits, como los dictados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après l’arrêt d’un enregistrement et au lancement de l’app, les pistes des réunions sont compressées sans perte — en 24 bits, comme les dictées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al termine della registrazione e all’avvio dell’app, le tracce delle riunioni vengono compresse senza perdita — a 24 bit, come le dettature."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "録音の停止後とアプリの起動時に、ミーティングのトラックはロスレスで圧縮されます（音声入力と同じく 24 ビット）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "녹음이 끝난 후와 앱이 시작될 때 회의 트랙은 받아쓰기와 마찬가지로 24비트로 무손실 압축됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po zatrzymaniu nagrywania i przy uruchomieniu aplikacji ścieżki spotkań są kompresowane bezstratnie — do 24 bitów, tak jak dyktowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ao terminar uma gravação e ao abrir o app, as faixas das reuniões são comprimidas sem perda — para 24 bits, como os ditados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После остановки записи и при запуске приложения дорожки созвонов сжимаются без потерь — до 24 бит, как диктовки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після зупинки запису та під час запуску програми доріжки зустрічей стискаються без втрат — до 24 біт, як і диктування."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "录音停止后以及 App 启动时，会议音轨会被无损压缩为 24 位，与听写相同。"
          }
        }
      }
    },
