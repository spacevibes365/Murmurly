          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Transcrita antes de que Murmurly guardara registros de sus transcripciones: no se sabe si el texto cubre toda la reunión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
