    "Stopped at the 4-hour limit for automatic recordings. Start a new recording to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gestoppt: Limit von 4 Stunden für automatische Aufnahmen erreicht. Starte eine neue Aufnahme, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se detuvo en el límite de 4 horas de las grabaciones automáticas. Para continuar, inicia una nueva grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrêté à la limite de 4 heures des enregistrements automatiques. Démarrez un nouvel enregistrement pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrotta al limite di 4 ore per le registrazioni automatiche. Per continuare, avvia una nuova registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "自動録音の上限（4 時間）に達したため停止しました。続けるには新しく録音を開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자동 녹음의 4시간 제한으로 중단되었습니다. 계속하려면 새 녹음을 시작하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zatrzymano po osiągnięciu limitu 4 godzin dla nagrań automatycznych. Aby kontynuować, rozpocznij nowe nagrywanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encerrada no limite de 4 horas das gravações automáticas. Para continuar, inicie uma nova gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановлено на пределе в 4 часа для автоматической записи. Чтобы продолжить, начните новую запись."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зупинено: досягнуто ліміту в 4 години для автоматичного запису. Щоб продовжити, почніть новий запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "已达到自动录音的 4 小时上限，录音已停止。如需继续，请开始新的录音。"
          }
        }
      }
    },
