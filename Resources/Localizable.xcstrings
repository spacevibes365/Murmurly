    "Entries %lld and %lld have the same id." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Einträge %1$lld und %2$lld haben dieselbe id."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las entradas %1$lld y %2$lld tienen el mismo id."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les entrées %1$lld et %2$lld ont le même id."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le voci %1$lld e %2$lld hanno lo stesso id."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "項目 %1$lld と %2$lld の id が同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "항목 %1$lld과(와) %2$lld의 id가 같습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wpisy %1$lld i %2$lld mają to samo id."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As entradas %1$lld e %2$lld têm o mesmo id."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У записей %1$lld и %2$lld один и тот же id."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Записи %1$lld і %2$lld мають однаковий id."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "第 %1$lld 个和第 %2$lld 个条目的 id 相同。"
          }
        }
      }
    },
    "Entries in the file: %lld. Adding keeps yours and adds the file’s new ones. Replacing deletes yours, %lld in all, and takes the file’s as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einträge in der Datei: %1$lld. Hinzufügen behält deine und ergänzt die neuen aus der Datei. Ersetzen löscht deine, insgesamt %2$lld, und übernimmt die der Datei unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entradas en el archivo: %1$lld. Añadir conserva las tuyas y suma las nuevas del archivo. Reemplazar elimina las tuyas, %2$lld en total, y toma las del archivo tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entrées dans le fichier : %1$lld. Ajouter conserve les vôtres et ajoute les nouvelles du fichier. Remplacer supprime les vôtres, %2$lld au total, et reprend celles du fichier telles quelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Voci nel file: %1$lld. Aggiungere mantiene le tue e aggiunge le nuove del file. Sostituire elimina le tue, %2$lld in tutto, e prende quelle del file così come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ファイル内の項目：%1$lld件。「追加」では自分の項目を残し、ファイルの新しい項目を加えます。「置き換え」では自分の項目（全%2$lld件）を削除し、ファイルの項目をそのまま使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "파일의 항목: %1$lld개. 추가하면 내 항목은 그대로 두고 파일의 새 항목을 더합니다. 바꾸면 내 항목 %2$lld개를 모두 삭제하고 파일의 항목을 그대로 가져옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wpisy w pliku: %1$lld. Dodanie zachowa Twoje i doda nowe z pliku. Zastąpienie usunie Twoje, łącznie %2$lld, i przyjmie wpisy z pliku bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entradas no arquivo: %1$lld. Adicionar mantém as suas e inclui as novas do arquivo. Substituir apaga as suas, %2$lld no total, e usa as do arquivo como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записей в файле: %1$lld. «Добавить» сохранит ваши записи и добавит новые из файла. «Заменить» удалит ваши — всего %2$lld — и возьмёт записи файла как есть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Записів у файлі: %1$lld. «Додати» збереже ваші записи й додасть нові з файлу. «Замінити» видалить ваші — усього %2$lld — і візьме записи файлу як є."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "文件中的条目：%1$lld 个。“添加”会保留你的条目并加入文件中的新条目。“替换”会删除你的全部 %2$lld 个条目，并按原样采用文件中的条目。"
          }
        }
      }
    },
