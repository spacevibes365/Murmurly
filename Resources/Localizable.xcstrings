    "%@ isn’t supported by %@. Auto is used; your choice is kept for %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ wird von %2$@ nicht unterstützt. „Auto“ wird verwendet; deine Auswahl bleibt für %3$@ gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ isn’t supported by %2$@. Auto is used; your choice is kept for %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El idioma %1$@ no es compatible con %2$@. Se usa «Automático»; tu elección se conserva para %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La langue %1$@ n’est pas prise en charge par le moteur %2$@. « Auto » est utilisé ; votre choix est conservé pour %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ non supporta questa lingua (%1$@). Viene usato «Automatico»; la tua scelta resta salvata per %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ は %1$@ に対応していません。「自動」を使用します。選択した言語は %3$@ 用に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@: %2$@ 엔진에서 지원되지 않는 언어입니다. “자동”이 사용되며, 선택한 언어는 %3$@ 엔진용으로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Język %1$@ nie jest obsługiwany przez silnik %2$@. Używana jest opcja „Automatycznie”; Twój wybór zostaje zachowany dla silnika %3$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O idioma %1$@ não é compatível com o mecanismo %2$@. “Automático” está em uso; sua escolha fica salva para o %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не поддерживается движком %2$@. Используется «Авто»; ваш выбор сохранён для %3$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ не підтримується рушієм %2$@. Використовується «Авто»; ваш вибір збережено для %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%2$@ 不支持 %1$@。已改用“自动”；你的选择会为 %3$@ 保留。"
