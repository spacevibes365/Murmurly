    "“%@” is the microphone, “%@” is the system audio; the other voices are not told apart. Echo lines removed from the microphone: %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ ist das Mikrofon, „%2$@“ das Systemaudio; die anderen Stimmen werden nicht unterschieden. Aus dem Mikrofon entfernte Echo-Zeilen: %3$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is the microphone, “%2$@” is the system audio; the other voices are not told apart. Echo lines removed from the microphone: %3$lld."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» es el micrófono y «%2$@», el audio del sistema; las demás voces no se distinguen entre sí. Líneas de eco eliminadas del micrófono: %3$lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %1$@ » correspond au micro, « %2$@ » à l’audio du système ; les autres voix ne sont pas distinguées. Répliques d’écho retirées du micro : %3$lld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» è il microfono, «%2$@» è l’audio di sistema; le altre voci non vengono distinte. Battute di eco rimosse dal microfono: %3$lld."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%1$@」はマイク、「%2$@」はシステムオーディオです。相手の声は人ごとに区別されません。マイクからエコーとして除去した発言：%3$lld。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@” — 마이크, “%2$@” — 시스템 오디오. 상대방 음성은 서로 구분되지 않습니다. 마이크에서 제거된 에코 줄: %3$lld개."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@” to mikrofon, „%2$@” to dźwięk systemowy; pozostałe głosy nie są rozróżniane. Wypowiedzi z echem usunięte z mikrofonu: %3$lld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@” é o microfone, “%2$@” é o áudio do sistema; as outras vozes não são diferenciadas. Falas de eco removidas do microfone: %3$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» — микрофон, «%2$@» — системный звук; голоса собеседников не различаются. Эхо с микрофона убрано: %3$lld."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» — мікрофон, «%2$@» — системний звук; голоси співрозмовників не розрізняються. Прибрано реплік-відлунь із мікрофона: %3$lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@”是麦克风，“%2$@”是系统音频；对方的多个声音不作区分。从麦克风中去除的回声发言数：%3$lld。"
          }
        }
      }
    },
