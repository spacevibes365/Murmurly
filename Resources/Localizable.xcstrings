    "Open a text field, say a phrase, then press %@ to finish. Without Accessibility, paste the text with ⌘V." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Öffne ein Textfeld, sprich einen Satz und drücke dann %@, um abzuschließen. Ohne Bedienungshilfen fügst du den Text mit ⌘V ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre un campo de texto, di una frase y pulsa %@ para terminar. Sin Accesibilidad, pega el texto con ⌘V."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez un champ de texte, dites une phrase, puis appuyez sur %@ pour terminer. Sans l’Accessibilité, collez le texte avec ⌘V."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apri un campo di testo, di’ una frase, poi premi %@ per terminare. Senza Accessibilità, incolla il testo con ⌘V."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "テキストフィールドを開き、フレーズを話してから、%@ を押して終了してください。アクセシビリティがない場合は、⌘V でテキストをペーストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "텍스트 필드를 열고 문장을 말한 다음 %@ 키를 눌러 끝내십시오. 손쉬운 사용 권한이 없으면 ⌘V로 텍스트를 붙여넣으십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otwórz pole tekstowe, powiedz jakieś zdanie, a następnie naciśnij %@, aby zakończyć. Bez uprawnienia Dostępność wklej tekst, naciskając ⌘V."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abra um campo de texto, diga uma frase e depois pressione %@ para terminar. Sem a Acessibilidade, cole o texto com ⌘V."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте поле ввода, скажите фразу и нажмите %@, чтобы закончить. Без Универсального доступа вставьте текст через ⌘V."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Відкрийте текстове поле, скажіть фразу й натисніть %@, щоб завершити. Без Універсального доступу вставте текст за допомогою ⌘V."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
