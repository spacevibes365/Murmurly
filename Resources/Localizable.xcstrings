    "Two quick presses start recording, one stops it. Ordinary shortcuts stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zweimal schnell drücken startet die Aufnahme, einmal drücken beendet sie. Normale Tastenkombinationen bleiben frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dos pulsaciones rápidas inician la grabación y una la detiene. Los atajos habituales quedan libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deux pressions rapides démarrent l’enregistrement, une seule l’arrête. Les raccourcis habituels restent libres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Due pressioni rapide avviano la registrazione, una la interrompe. Le abbreviazioni normali restano libere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すばやく 2 回押すと録音を開始し、1 回押すと停止します。通常のキーボードショートカットはそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "빠르게 두 번 누르면 녹음이 시작되고, 한 번 누르면 중단됩니다. 일반 키보드 단축키는 그대로 사용할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dwa szybkie naciśnięcia rozpoczynają nagrywanie, jedno je zatrzymuje. Zwykłe skróty klawiszowe pozostają wolne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dois pressionamentos rápidos iniciam a gravação; um a encerra. Os atalhos comuns continuam livres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два быстрых нажатия начинают запись, одно — останавливает. Обычные сочетания остаются свободными."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Два швидкі натискання починають запис, одне — зупиняє. Звичайні сполучення клавіш лишаються вільними."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "快速按两次开始录音，按一次停止。普通快捷键不受影响。"
          }
        }
      }
    },
